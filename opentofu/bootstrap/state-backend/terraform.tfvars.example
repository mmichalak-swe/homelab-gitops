aws_region        = "us-east-1"
state_bucket_name = "replace-with-your-existing-state-bucket-name"

state_bucket_tags = {
  Environment = "homelab"
}

# Optional retention overrides. Defaults retain the ten newest noncurrent
# versions and do not expire excess versions until they are at least 30 days old.
# noncurrent_versions_to_retain        = 5
# noncurrent_version_expiration_days   = 30
